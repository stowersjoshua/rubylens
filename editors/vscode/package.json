{
  "name": "rubylens",
  "displayName": "RubyLens — Read Rust as Ruby",
  "description": "Open any Rust file as a generated, read-only Ruby view. Go to definition, hover, references and outline work through rust-analyzer.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Other"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:rust", "onFileSystem:rubylens"],
  "extensionDependencies": ["rust-lang.rust-analyzer"],
  "contributes": {
    "commands": [
      { "command": "rubylens.open", "title": "Open as Ruby", "category": "RubyLens", "icon": "$(ruby)" },
      { "command": "rubylens.showRust", "title": "Show Rust Source", "category": "RubyLens", "icon": "$(go-to-file)" },
      { "command": "rubylens.buildCache", "title": "Pre-generate Ruby Views for Workspace", "category": "RubyLens" }
    ],
    "menus": {
      "editor/title": [
        { "command": "rubylens.open", "when": "resourceLangId == rust", "group": "navigation" },
        { "command": "rubylens.showRust", "when": "resourceScheme == rubylens", "group": "navigation" }
      ],
      "explorer/context": [
        { "command": "rubylens.open", "when": "resourceExtname == .rs", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "rubylens.open", "when": "resourceLangId == rust" },
        { "command": "rubylens.showRust", "when": "resourceScheme == rubylens" }
      ]
    },
    "keybindings": [
      { "command": "rubylens.open", "key": "ctrl+alt+r", "mac": "cmd+alt+r", "when": "editorLangId == rust" },
      { "command": "rubylens.showRust", "key": "ctrl+alt+r", "mac": "cmd+alt+r", "when": "resourceScheme == rubylens" }
    ],
    "configuration": {
      "title": "RubyLens",
      "properties": {
        "rubylens.executable": {
          "type": "string",
          "default": "rubylens",
          "description": "Path to the rubylens binary (built with `cargo install --path .`)."
        },
        "rubylens.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "Open the Ruby view beside the Rust file rather than replacing it."
        }
      }
    }
  }
}
